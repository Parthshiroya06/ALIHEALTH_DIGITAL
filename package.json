{
  "name": "RNLatest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "project-clean": "yarn cleanup; yarn; cd android && ./gradlew clean && cd .. && cd ios && pod install && cd ..",
    "cleanup": "rm -rf node_modules yarn.lock android/app/build ios/build ios/Pods ios/Podfile.lock",
    "apk-release": "cd android && ./gradlew clean && ./gradlew assembleRelease && open . && cd ..",
    "apk-bundle": "cd android && ./gradlew clean && ./gradlew bundleRelease && open . && cd ..",
    "tsc": "tsc --noEmit",
    "sdk:hband": "./scripts/fetch-hband-sdk.sh",
    "nitrogen": "cd modules/react-native-aliband-sdk && nitrogen"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.19.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-aliband-sdk": "link:./modules/react-native-aliband-sdk",
    "react-native-ble-plx": "^3.5.1",
    "react-native-device-info": "^15.0.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-webview": "^14.0.1",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "nitrogen": "0.37.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
